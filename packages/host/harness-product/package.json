{
  "name": "@deepseek-ai/dsh-host-harness-product",
  "version": "0.2.2-rc.3",
  "description": "Web 与 Electron 共用的账号认证、部署配置与运行保护",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./auth-client": {
      "types": "./lib/types/auth-client.d.ts",
      "default": "./lib/auth-client.js"
    },
    "./config": {
      "types": "./lib/types/config.d.ts",
      "default": "./lib/config.js"
    },
    "./home": {
      "types": "./lib/types/home.d.ts",
      "default": "./lib/home.js"
    },
    "./composition": {
      "types": "./lib/types/composition.d.ts",
      "default": "./lib/composition.js"
    },
    "./model-composition": {
      "types": "./lib/types/model-composition.d.ts",
      "default": "./lib/model-composition.js"
    },
    "./authorization": {
      "types": "./lib/types/authorization.d.ts",
      "default": "./lib/authorization.js"
    },
    "./secret": {
      "types": "./lib/types/secret.d.ts",
      "default": "./lib/secret.js"
    },
    "./desktop-start": {
      "types": "./lib/types/desktop-start.d.ts",
      "default": "./lib/desktop-start.js"
    },
    "./process-tree": {
      "types": "./lib/types/process-tree.d.ts",
      "default": "./lib/process-tree.js"
    },
    "./embed/controller": {
      "types": "./lib/types/embed/controller.d.ts",
      "default": "./lib/embed/controller.js"
    },
    "./embed/runtime": {
      "types": "./lib/types/embed/runtime.d.ts",
      "default": "./lib/embed/runtime.js"
    },
    "./downloads": {
      "types": "./lib/types/downloads.d.ts",
      "default": "./lib/downloads.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "lib/**/*.js.map",
    "src"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-error": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "proper-lockfile": "^4.1.2",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-subprocess-local": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@types/proper-lockfile": "^4.1.4",
    "@deepseek-ai/dsh-client-connection": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-api-remote-access": "workspace:*",
    "@deepseek-ai/dsh-api-session-controller": "workspace:*",
    "@deepseek-ai/dsh-host-directory-picker": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-tool-present": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-user-approval": "workspace:*",
    "@deepseek-ai/dsh-user-questions": "workspace:*",
    "@deepseek-ai/dsh-schedule": "workspace:*",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-llm": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/host/harness-product"
  }
}
